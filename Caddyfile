{
	# Email used for Let's Encrypt registration / expiry notices.
	email admin@klinica.space

	# Tenant sites live on subdomains of klinica.space. On-demand TLS issues a
	# certificate for each tenant hostname the first time it is visited, so we
	# need neither a wildcard certificate nor DNS-provider API credentials.
	# Caddy asks the app before issuing; /up returns 200, and the wildcard site
	# block below already scopes issuance to *.klinica.space.
	on_demand_tls {
		ask http://web:8000/up
	}
}

# Central application: apex + www.
klinica.space, www.klinica.space {
	encode zstd gzip
	reverse_proxy web:8000
}

# Tenant subdomains: one certificate per host, issued on demand.
*.klinica.space {
	encode zstd gzip
	tls {
		on_demand
	}
	reverse_proxy web:8000
}
