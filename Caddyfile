{
	email admin@klinica.space
}

# Served behind Cloudflare (proxied / orange-cloud) with SSL mode Full (strict).
# Caddy presents a Cloudflare Origin CA certificate that covers the apex and all
# first-level tenant subdomains; Cloudflare trusts it on the edge-to-origin hop,
# so no Let's Encrypt / ACME is used here. The cert and key are mounted from
# ./certs (gitignored — never commit them).
klinica.space, www.klinica.space, *.klinica.space {
	encode zstd gzip
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy web:8000
}
