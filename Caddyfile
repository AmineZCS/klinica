{
	email admin@klinica.space
}

# Behind Cloudflare (Full strict): Caddy serves a Cloudflare Origin CA cert from
# ./certs (gitignored), so no ACME. The cert covers the apex and tenant subdomains.
klinica.space, www.klinica.space, *.klinica.space {
	encode zstd gzip
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy web:8000
}
